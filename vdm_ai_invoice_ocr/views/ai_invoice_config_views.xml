<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_invoice_config_form" model="ir.ui.view">
        <field name="name">ai.invoice.config.form</field>
        <field name="model">ai.invoice.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="AI Provider">
                            <field name="provider"/>
                            <field name="api_key" password="True"/>
                            <field name="model"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Extraction Settings">
                            <field name="extraction_mode"/>
                            <field name="extract_lines"/>
                            <field name="auto_extract"/>
                            <field name="background_extract"/>
                            <field name="qr_extraction"/>
                            <field name="learning_enabled"/>
                        </group>
                    </group>
                    <group string="Advanced">
                        <group>
                            <field name="max_tokens"/>
                            <field name="temperature"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_invoice_config_list" model="ir.ui.view">
        <field name="name">ai.invoice.config.list</field>
        <field name="model">ai.invoice.config</field>
        <field name="arch" type="xml">
            <list string="AI Configurations">
                <field name="name"/>
                <field name="provider"/>
                <field name="model"/>
                <field name="extraction_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_ai_invoice_config" model="ir.actions.act_window">
        <field name="name">AI Invoice Configurations</field>
        <field name="res_model">ai.invoice.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
