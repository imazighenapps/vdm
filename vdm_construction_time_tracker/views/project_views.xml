<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_phase_tree" model="ir.ui.view">
        <field name="name">construction.project.phase.list</field>
        <field name="model">construction.project.phase</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_hours" widget="float_time"/>
                <field name="total_cost"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_project_phase_form" model="ir.ui.view">
        <field name="name">construction.project.phase.form</field>
        <field name="model">construction.project.phase</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_complete" type="object" string="Complete" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_hold" type="object" string="On Hold" invisible="state not in ('planned', 'in_progress')"/>
                    <button name="action_planned" type="object" string="Reset to Planned" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Phase Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sequence"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="total_hours" widget="float_time"/>
                            <field name="total_cost"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Phase description..."/>
                        </page>
                        <page string="Time Entries">
                            <field name="time_entry_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_phase_search" model="ir.ui.view">
        <field name="name">construction.project.phase.search</field>
        <field name="model">construction.project.phase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_phase" model="ir.actions.act_window">
        <field name="name">Project Phases</field>
        <field name="res_model">construction.project.phase</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_phase_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project phase
            </p>
            <p>Organize your construction project into phases.</p>
        </field>
    </record>
</odoo>
