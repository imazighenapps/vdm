<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_time_entry_tree" model="ir.ui.view">
        <field name="name">construction.time.entry.list</field>
        <field name="model">construction.time.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="entry_date"/>
                <field name="project_id"/>
                <field name="phase_id"/>
                <field name="worker_id"/>
                <field name="work_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="hourly_rate"/>
                <field name="total_cost"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_time_entry_form" model="ir.ui.view">
        <field name="name">construction.time.entry.form</field>
        <field name="model">construction.time.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'confirmed'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('confirmed', 'approved', 'rejected')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Time Entry Description"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="worker_id"/>
                            <field name="work_type"/>
                        </group>
                        <group>
                            <field name="entry_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="hourly_rate"/>
                            <field name="total_cost"/>
                            <field name="is_billable"/>
                        </group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="invoice_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_time_entry_search" model="ir.ui.view">
        <field name="name">construction.time.entry.search</field>
        <field name="model">construction.time.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="phase_id"/>
                <field name="worker_id"/>
                <field name="entry_date"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_phase" string="Phase" context="{'group_by': 'phase_id'}"/>
                    <filter name="group_worker" string="Worker" context="{'group_by': 'worker_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'entry_date'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_time_entry" model="ir.actions.act_window">
        <field name="name">Time Entries</field>
        <field name="res_model">construction.time.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_time_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first time entry
            </p>
            <p>Track time spent on construction projects.</p>
        </field>
    </record>
</odoo>
