<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_report_tree" model="ir.ui.view">
        <field name="name">construction.cost.line.list</field>
        <field name="model">construction.cost.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="project_id"/>
                <field name="phase_id"/>
                <field name="name"/>
                <field name="cost_type"/>
                <field name="amount"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_cost_report_form" model="ir.ui.view">
        <field name="name">construction.cost.line.form</field>
        <field name="model">construction.cost.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Cost Description"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="cost_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="partner_id"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Cost notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cost_report_search" model="ir.ui.view">
        <field name="name">construction.cost.line.search</field>
        <field name="model">construction.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="phase_id"/>
                <field name="cost_type"/>
                <field name="partner_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_phase" string="Phase" context="{'group_by': 'phase_id'}"/>
                    <filter name="group_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cost_report" model="ir.actions.act_window">
        <field name="name">Cost Reports</field>
        <field name="res_model">construction.cost.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cost_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cost entry
            </p>
            <p>Track costs associated with construction projects.</p>
        </field>
    </record>
</odoo>
