<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <record id="menu_construction_time_root" model="ir.ui.menu">
        <field name="name">Construction Time</field>
        <field name="sequence">100</field>
        <field name="web_icon">vdm_construction_time_tracker,static/description/icon.png</field>
    </record>

    <!-- Dashboard Menu -->
    <record id="menu_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="action" ref="action_dashboard"/>
        <field name="sequence">10</field>
    </record>

    <!-- Time Entries Menu -->
    <record id="menu_time_entries" model="ir.ui.menu">
        <field name="name">Time Entries</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="action" ref="action_time_entry"/>
        <field name="sequence">20</field>
    </record>

    <!-- Phases Menu -->
    <record id="menu_phases" model="ir.ui.menu">
        <field name="name">Project Phases</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="action" ref="action_project_phase"/>
        <field name="sequence">30</field>
    </record>

    <!-- Workers Menu -->
    <record id="menu_workers" model="ir.ui.menu">
        <field name="name">Workers</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="action" ref="action_worker"/>
        <field name="sequence">40</field>
    </record>

    <!-- Worker Skills Menu -->
    <record id="menu_worker_skills" model="ir.ui.menu">
        <field name="name">Worker Skills</field>
        <field name="parent_id" ref="menu_workers"/>
        <field name="action" ref="action_worker_skill"/>
        <field name="sequence">10</field>
    </record>

    <!-- Cost Reports Menu -->
    <record id="menu_cost_reports" model="ir.ui.menu">
        <field name="name">Cost Reports</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="action" ref="action_cost_report"/>
        <field name="sequence">50</field>
    </record>

    <!-- Configuration Menu -->
    <record id="menu_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="sequence">100</field>
        <field name="groups" eval="[(4, ref('group_time_manager'))]"/>
    </record>

    <!-- Reporting Menu -->
    <record id="menu_reporting" model="ir.ui.menu">
        <field name="name">Reporting</field>
        <field name="parent_id" ref="menu_construction_time_root"/>
        <field name="sequence">90</field>
    </record>
</odoo>
