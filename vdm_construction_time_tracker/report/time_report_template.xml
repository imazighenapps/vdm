<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_time_entry" model="ir.ui.view">
        <field name="name">vdm_construction_time_tracker.report_time_entry</field>
        <field name="model">ir.qweb</field>
        <field name="arch" type="xml">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Time Entry Report</h2>
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Project</th>
                                        <th>Phase</th>
                                        <th>Worker</th>
                                        <th>Type</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Duration</th>
                                        <th>Rate</th>
                                        <th>Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="docs" t-as="entry">
                                        <tr>
                                            <td><t t-out="entry.entry_date"/></td>
                                            <td><t t-out="entry.project_id.name"/></td>
                                            <td><t t-out="entry.phase_id.name"/></td>
                                            <td><t t-out="entry.worker_id.name"/></td>
                                            <td><t t-out="entry.work_type"/></td>
                                            <td><t t-fmt="entry.start_time" t-widget="float_time"/></td>
                                            <td><t t-fmt="entry.end_time" t-widget="float_time"/></td>
                                            <td><t t-fmt="entry.duration" t-widget="float_time"/></td>
                                            <td><t t-fmt="entry.hourly_rate" t-widget="monetary"/></td>
                                            <td><t t-fmt="entry.total_cost" t-widget="monetary"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7"><strong>Total</strong></td>
                                        <td><strong><t t-fmt="sum(docs.mapped('duration'))" t-widget="float_time"/></strong></td>
                                        <td></td>
                                        <td><strong><t t-fmt="sum(docs.mapped('total_cost'))" t-widget="monetary"/></strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </field>
    </record>
</odoo>
