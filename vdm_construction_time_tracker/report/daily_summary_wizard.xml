<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_summary_wizard_form" model="ir.ui.view">
        <field name="name">daily.summary.wizard.form</field>
        <field name="model">daily.summary.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="project_id"/>
                        <field name="worker_id"/>
                    </group>
                    <footer>
                        <button name="action_generate" type="object" string="Generate Report" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_daily_summary_wizard" model="ir.actions.act_window">
        <field name="name">Daily Summary Report</field>
        <field name="res_model">daily.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
