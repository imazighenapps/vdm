<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction_time" model="ir.module.category">
        <field name="name">Construction Time Tracking</field>
        <field name="description">Modules for construction time tracking and cost management</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_time_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_construction_time"/>
        <field name="comment">Basic access to time tracking features</field>
    </record>

    <record id="group_time_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_construction_time"/>
        <field name="implied_ids" eval="[(4, ref('group_time_user'))]"/>
        <field name="comment">Full access to time tracking and reporting</field>
    </record>

    <record id="group_time_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_construction_time"/>
        <field name="implied_ids" eval="[(4, ref('group_time_manager'))]"/>
        <field name="comment">Full system access including configuration</field>
    </record>

    <!-- Record Rules -->
    <record id="rule_time_entry_user" model="ir.rule">
        <field name="name">Time Entry: User Own Entries</field>
        <field name="model_id" ref="model_construction_time_entry"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_time_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_time_entry_manager" model="ir.rule">
        <field name="name">Time Entry: Manager Full Access</field>
        <field name="model_id" ref="model_construction_time_entry"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_project_phase_user" model="ir.rule">
        <field name="name">Project Phase: User Read Only</field>
        <field name="model_id" ref="model_construction_project_phase"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_phase_manager" model="ir.rule">
        <field name="name">Project Phase: Manager Full Access</field>
        <field name="model_id" ref="model_construction_project_phase"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_worker_user" model="ir.rule">
        <field name="name">Worker: User Read Only</field>
        <field name="model_id" ref="model_construction_worker"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_worker_manager" model="ir.rule">
        <field name="name">Worker: Manager Full Access</field>
        <field name="model_id" ref="model_construction_worker"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_cost_line_user" model="ir.rule">
        <field name="name">Cost Line: User Read Only</field>
        <field name="model_id" ref="model_construction_cost_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_cost_line_manager" model="ir.rule">
        <field name="name">Cost Line: Manager Full Access</field>
        <field name="model_id" ref="model_construction_cost_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_time_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Menu Access -->
    <record id="menu_time_entry_root" model="ir.ui.menu">
        <field name="name">Construction Time</field>
        <field name="sequence">100</field>
    </record>
</odoo>
