<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RA Billing List View -->
    <record id="construction_ra_billing_view_list" model="ir.ui.view">
        <field name="name">construction.ra.billing.list</field>
        <field name="model">construction.ra.billing</field>
        <field name="arch" type="xml">
            <list string="RA Billing">
                <field name="name"/>
                <field name="project_id"/>
                <field name="period"/>
                <field name="billing_date"/>
                <field name="total_amount"/>
                <field name="retention_amount"/>
                <field name="advance_recovery"/>
                <field name="net_payable"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'paid'"/>
            </list>
        </field>
    </record>

    <!-- RA Billing Form View -->
    <record id="construction_ra_billing_view_form" model="ir.ui.view">
        <field name="name">construction.ra.billing.form</field>
        <field name="model">construction.ra.billing</field>
        <field name="arch" type="xml">
            <form string="RA Billing">
                <header>
                    <button name="action_submit" type="object" class="oe_highlight" string="Submit" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" class="oe_highlight" string="Approve" invisible="state != 'submitted'" groups="construction_core.group_construction_manager"/>
                    <button name="action_pay" type="object" class="oe_highlight" string="Mark Paid" invisible="state != 'approved'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" invisible="state not in ('approved','paid')" class="oe_highlight"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('submitted','approved','paid')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="RA Billing Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="period"/>
                            <field name="billing_date"/>
                        </group>
                        <group>
                            <field name="previous_bill_amount"/>
                            <field name="total_amount"/>
                            <field name="retention_pct"/>
                            <field name="retention_amount"/>
                            <field name="advance_recovery"/>
                            <field name="net_payable"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Billing Lines" name="lines">
                            <field name="bill_line_ids"/>
                        </page>
                        <page string="Invoice" name="invoice" invisible="not invoice_id">
                            <field name="invoice_id" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Billing notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- RA Billing Search View -->
    <record id="construction_ra_billing_view_search" model="ir.ui.view">
        <field name="name">construction.ra.billing.search</field>
        <field name="model">construction.ra.billing</field>
        <field name="arch" type="xml">
            <search string="Search RA Billing">
                <field name="name"/>
                <field name="project_id"/>
                <field name="period"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RA Billing Action -->
    <record id="action_construction_ra_billing" model="ir.actions.act_window">
        <field name="name">RA Billing</field>
        <field name="res_model">construction.ra.billing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_ra_billing_view_search"/>
    </record>

    <!-- RA Billing Line List View -->
    <record id="construction_ra_billing_line_view_list" model="ir.ui.view">
        <field name="name">construction.ra.billing.line.list</field>
        <field name="model">construction.ra.billing.line</field>
        <field name="arch" type="xml">
            <list string="RA Billing Lines" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="boq_line_id"/>
                <field name="phase_id"/>
                <field name="quantity"/>
                <field name="unit_rate"/>
                <field name="amount"/>
            </list>
        </field>
    </record>
</odoo>
