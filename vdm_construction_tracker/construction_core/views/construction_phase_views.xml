<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phase List View -->
    <record id="construction_phase_view_list" model="ir.ui.view">
        <field name="name">construction.phase.list</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <list string="Construction Phases">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="work_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="budget_amount"/>
                <field name="actual_cost"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <!-- Phase Form View -->
    <record id="construction_phase_view_form" model="ir.ui.view">
        <field name="name">construction.phase.form</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <form string="Construction Phase">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Phase Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="work_type"/>
                            <field name="state" widget="statusbar"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="weight"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget" name="budget">
                            <group>
                                <field name="budget_amount"/>
                                <field name="actual_cost"/>
                            </group>
                        </page>
                        <page string="Work Orders" name="work_orders">
                            <field name="work_order_ids"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Phase description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Phase Search View -->
    <record id="construction_phase_view_search" model="ir.ui.view">
        <field name="name">construction.phase.search</field>
        <field name="model">construction.phase</field>
        <field name="arch" type="xml">
            <search string="Search Phases">
                <field name="name"/>
                <field name="project_id"/>
                <field name="work_type"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_work_type" string="Work Type" context="{'group_by': 'work_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Phase Action -->
    <record id="action_construction_phase" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">construction.phase</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_phase_view_search"/>
    </record>
</odoo>
