<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_construction" model="res.groups.privilege">
        <field name="name">Construction</field>
        <field name="category_id" ref="base.module_category_project_management"/>
        <field name="sequence">50</field>
    </record>

    <!-- User Group -->
    <record id="group_construction_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_construction_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <!-- Admin Group -->
    <record id="group_construction_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
    </record>

    <!-- Record Rules: Multi-company -->
    <record id="rule_construction_project_company" model="ir.rule">
        <field name="name">Construction Project: Multi-company</field>
        <field name="model_id" ref="model_construction_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_construction_phase_company" model="ir.rule">
        <field name="name">Construction Phase: Multi-company</field>
        <field name="model_id" ref="model_construction_phase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
