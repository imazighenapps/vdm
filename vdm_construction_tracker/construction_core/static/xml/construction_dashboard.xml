<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="vdm_construction_tracker.ConstructionDashboard">
        <div class="o_construction_dashboard p-4">
            <!-- Loading -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p class="mt-3">Loading dashboard...</p>
            </div>

            <!-- Stats Cards -->
            <div t-if="!state.loading" class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5 class="card-title">Total Projects</h5>
                            <h2><t t-esc="state.stats.total_projects"/></h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h5 class="card-title">Active Projects</h5>
                            <h2><t t-esc="state.stats.active_projects"/></h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h5 class="card-title">Total Contract Value</h5>
                            <h2>
                                <t t-esc="state.stats.total_value" t-options="{'widget': 'monetary', 'currency': 'EUR'}"/>
                            </h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h5 class="card-title">Average Progress</h5>
                            <h2><t t-esc="state.stats.avg_progress"/>%</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div t-if="!state.loading" class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="btn-group me-2">
                                <button class="btn btn-primary" t-on-click="openAllProjects">
                                    <i class="fa fa-folder-open"/> All Projects
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <button class="btn btn-secondary" t-on-click="openDPR">
                                    <i class="fa fa-calendar"/> Daily Reports
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <button class="btn btn-secondary" t-on-click="openBOQ">
                                    <i class="fa fa-list-ol"/> BOQ
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <button class="btn btn-secondary" t-on-click="openBilling">
                                    <i class="fa fa-money"/> Billing
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <button class="btn btn-secondary" t-on-click="openChangeOrders">
                                    <i class="fa fa-exchange"/> Change Orders
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <button class="btn btn-secondary" t-on-click="openSubcontracts">
                                    <i class="fa fa-users"/> Subcontracts
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alerts -->
            <div t-if="state.alerts.length > 0" class="row mb-4">
                <div class="col-12">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="fa fa-exclamation-triangle"/> Alerts</h5>
                        </div>
                        <div class="card-body">
                            <div t-foreach="state.alerts" t-as="alert" class="alert alert-warning">
                                <t t-esc="alert.message"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Projects List -->
            <div t-if="!state.loading" class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Recent Projects</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Project</th>
                                        <th>Client</th>
                                        <th>Contract Value</th>
                                        <th>Progress</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.projects" t-as="project">
                                        <tr t-on-click="() => this.openProject(project.id)" class="cursor-pointer">
                                            <td><t t-esc="project.reference"/></td>
                                            <td><t t-esc="project.name"/></td>
                                            <td><t t-esc="project.client"/></td>
                                            <td>
                                                <t t-esc="project.contract_value" t-options="{'widget': 'monetary', 'currency': 'EUR'}"/>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         t-att-style="'width: ' + project.progress + '%'"
                                                         t-att-aria-valuenow="project.progress"
                                                         aria-valuemin="0" aria-valuemax="100">
                                                        <t t-esc="project.progress"/>%
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span t-attf-class="badge {{getStateDecoration(project.state)}}">
                                                    <t t-esc="getStateLabel(project.state)"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
