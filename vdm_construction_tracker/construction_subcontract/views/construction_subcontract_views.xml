<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subcontract List View -->
    <record id="construction_subcontract_view_list" model="ir.ui.view">
        <field name="name">construction.subcontract.list</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <list string="Subcontracts">
                <field name="name"/>
                <field name="project_id"/>
                <field name="vendor_id"/>
                <field name="contract_value"/>
                <field name="retention_amount"/>
                <field name="amount_paid"/>
                <field name="amount_remaining"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'active'"/>
            </list>
        </field>
    </record>

    <!-- Subcontract Form View -->
    <record id="construction_subcontract_view_form" model="ir.ui.view">
        <field name="name">construction.subcontract.form</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <form string="Subcontract">
                <header>
                    <button name="action_activate" type="object" class="oe_highlight" string="Activate" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" class="oe_highlight" string="Complete" invisible="state != 'active'"/>
                    <button name="action_settle" type="object" class="oe_highlight" string="Settle" invisible="state != 'completed'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('active','completed','settled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Subcontract Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="vendor_id"/>
                            <field name="phase_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="contract_value"/>
                            <field name="retention_pct"/>
                            <field name="retention_amount"/>
                            <field name="amount_paid"/>
                            <field name="amount_remaining"/>
                            <field name="total_measured"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope" name="scope">
                            <field name="scope_of_work" placeholder="Describe the scope of work..."/>
                        </page>
                        <page string="Measurements" name="measurements">
                            <field name="measurement_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subcontract Search View -->
    <record id="construction_subcontract_view_search" model="ir.ui.view">
        <field name="name">construction.subcontract.search</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <search string="Search Subcontracts">
                <field name="name"/>
                <field name="project_id"/>
                <field name="vendor_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_vendor" string="Subcontractor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Subcontract Action -->
    <record id="action_construction_subcontract" model="ir.actions.act_window">
        <field name="name">Subcontracts</field>
        <field name="res_model">construction.subcontract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_subcontract_view_search"/>
    </record>
</odoo>
