<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BOQ List View -->
    <record id="construction_boq_view_list" model="ir.ui.view">
        <field name="name">construction.boq.list</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <list string="Bill of Quantities">
                <field name="name"/>
                <field name="project_id"/>
                <field name="revision"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- BOQ Form View -->
    <record id="construction_boq_view_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities">
                <header>
                    <button name="action_approve" type="object" class="oe_highlight" string="Approve" invisible="state != 'draft'"/>
                    <button name="action_revise" type="object" string="Revise" invisible="state != 'approved'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('approved','revised')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="BOQ Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="revision"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Lines" name="lines">
                            <field name="line_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- BOQ Search View -->
    <record id="construction_boq_view_search" model="ir.ui.view">
        <field name="name">construction.boq.search</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <search string="Search BOQs">
                <field name="name"/>
                <field name="project_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- BOQ Action -->
    <record id="action_construction_boq" model="ir.actions.act_window">
        <field name="name">Bill of Quantities</field>
        <field name="res_model">construction.boq</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_boq_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BOQ
            </p>
        </field>
    </record>
</odoo>
