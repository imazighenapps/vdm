<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbam_supplier_form" model="ir.ui.view">
        <field name="name">cbam.supplier.form</field>
        <field name="model">cbam.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Supplier Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Supplier Details">
                            <field name="partner_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="supplier_country_id"/>
                            <field name="cbam_registered"/>
                            <field name="cbam_registration_number" invisible="not cbam_registered"/>
                        </group>
                        <group string="Emission Data">
                            <field name="actual_emission"/>
                            <field name="use_default_value"/>
                            <field name="default_emission" invisible="not use_default_value"/>
                            <field name="effective_emission"/>
                            <field name="data_status" widget="badge"/>
                            <field name="last_data_request"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Emission Records" name="emissions">
                            <field name="emission_data_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cbam_supplier_list" model="ir.ui.view">
        <field name="name">cbam.supplier.list</field>
        <field name="model">cbam.supplier</field>
        <field name="arch" type="xml">
            <list string="CBAM Suppliers">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="supplier_country_id"/>
                <field name="cbam_registered" widget="boolean_toggle"/>
                <field name="actual_emission"/>
                <field name="effective_emission"/>
                <field name="data_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cbam_supplier_search" model="ir.ui.view">
        <field name="name">cbam.supplier.search</field>
        <field name="model">cbam.supplier</field>
        <field name="arch" type="xml">
            <search string="CBAM Suppliers">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <filter name="filter_registered" string="CBAM Registered" domain="[('cbam_registered', '=', True)]"/>
                <filter name="filter_pending" string="Pending Data" domain="[('data_status', '=', 'pending')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'supplier_country_id'}"/>
                    <filter string="Data Status" name="group_data_status" context="{'group_by': 'data_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cbam_suppliers" model="ir.actions.act_window">
        <field name="name">CBAM Suppliers</field>
        <field name="res_model">cbam.supplier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No CBAM suppliers configured yet.
            </p>
            <p>
                Add suppliers with their emission data for CBAM compliance.
            </p>
        </field>
    </record>
</odoo>
