<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbam_import_event_form" model="ir.ui.view">
        <field name="name">cbam.import.event.form</field>
        <field name="model">cbam.import.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="status != 'draft'" class="oe_highlight"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="status != 'submitted'" class="oe_highlight"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Import Event Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Import Details">
                            <field name="import_date"/>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                            <field name="origin_country_id"/>
                            <field name="sector"/>
                        </group>
                        <group string="Emissions">
                            <field name="quantity"/>
                            <field name="emission_factor"/>
                            <field name="total_emissions" class="text-danger"/>
                            <field name="purchase_order_id"/>
                            <field name="stock_picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <group>
                                <field name="geo_json_file" filename="geo_json_filename"/>
                                <field name="geo_json_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this import..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cbam_import_event_list" model="ir.ui.view">
        <field name="name">cbam.import.event.list</field>
        <field name="model">cbam.import.event</field>
        <field name="arch" type="xml">
            <list string="Import Events" decoration-danger="status == 'draft'"
                  decoration-warning="status == 'submitted'" decoration-success="status == 'confirmed'">
                <field name="name"/>
                <field name="import_date"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="origin_country_id"/>
                <field name="sector"/>
                <field name="quantity" sum="Total"/>
                <field name="emission_factor"/>
                <field name="total_emissions" sum="Total Emissions"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cbam_import_event_search" model="ir.ui.view">
        <field name="name">cbam.import.event.search</field>
        <field name="model">cbam.import.event</field>
        <field name="arch" type="xml">
            <search string="Import Events">
                <field name="name"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <filter name="filter_draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('status', '=', 'submitted')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('status', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_this_year" string="This Year" domain="[('import_date', '>=', context_today().strftime('%%Y-01-01')), ('import_date', '&lt;=', context_today().strftime('%%Y-12-31'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Sector" name="group_sector" context="{'group_by': 'sector'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Country" name="group_country" context="{'group_by': 'origin_country_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'import_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cbam_import_events" model="ir.actions.act_window">
        <field name="name">CBAM Import Events</field>
        <field name="res_model">cbam.import.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No import events recorded yet.
            </p>
            <p>
                Record your CBAM-covered imports to track embedded emissions.
            </p>
        </field>
    </record>
</odoo>
