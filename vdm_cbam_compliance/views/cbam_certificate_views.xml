<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbam_certificate_form" model="ir.ui.view">
        <field name="name">cbam.certificate.form</field>
        <field name="model">cbam.certificate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Certificate Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Certificate Details">
                            <field name="purchase_date"/>
                            <field name="quantity"/>
                            <field name="price_per_unit"/>
                            <field name="total_cost"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"/>
                            <field name="remaining_quantity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Surrenders" name="surrenders">
                            <field name="surrendered_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cbam_certificate_list" model="ir.ui.view">
        <field name="name">cbam.certificate.list</field>
        <field name="model">cbam.certificate</field>
        <field name="arch" type="xml">
            <list string="Certificates" decoration-success="status == 'available'"
                  decoration-warning="status == 'partial'" decoration-danger="status == 'surrendered'">
                <field name="name"/>
                <field name="purchase_date"/>
                <field name="quantity"/>
                <field name="price_per_unit"/>
                <field name="total_cost"/>
                <field name="remaining_quantity"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cbam_certificate_search" model="ir.ui.view">
        <field name="name">cbam.certificate.search</field>
        <field name="model">cbam.certificate</field>
        <field name="arch" type="xml">
            <search string="CBAM Certificates">
                <field name="name"/>
                <filter name="filter_available" string="Available" domain="[('status', 'in', ['available', 'partial'])]"/>
                <filter name="filter_surrendered" string="Fully Surrendered" domain="[('status', '=', 'surrendered')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cbam_certificates" model="ir.actions.act_window">
        <field name="name">CBAM Certificates</field>
        <field name="res_model">cbam.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No certificates purchased yet.
            </p>
        </field>
    </record>
</odoo>
