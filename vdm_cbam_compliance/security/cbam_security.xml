<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="module_category_cbam" model="res.groups.privilege">
        <field name="name">CBAM Compliance</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_cbam_user" model="res.groups">
        <field name="name">CBAM User</field>
        <field name="privilege_id" ref="module_category_cbam"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cbam_manager" model="res.groups">
        <field name="name">CBAM Manager</field>
        <field name="privilege_id" ref="module_category_cbam"/>
        <field name="implied_ids" eval="[(4, ref('group_cbam_user'))]"/>
    </record>

    <record id="group_cbam_admin" model="res.groups">
        <field name="name">CBAM Admin</field>
        <field name="privilege_id" ref="module_category_cbam"/>
        <field name="implied_ids" eval="[(4, ref('group_cbam_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_cbam_product_user" model="ir.rule">
        <field name="name">CBAM Product: User</field>
        <field name="model_id" ref="model_cbam_product"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_cbam_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_cbam_product_manager" model="ir.rule">
        <field name="name">CBAM Product: Manager</field>
        <field name="model_id" ref="model_cbam_product"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_cbam_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_cbam_import_event_user" model="ir.rule">
        <field name="name">CBAM Import Event: User</field>
        <field name="model_id" ref="model_cbam_import_event"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_cbam_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_cbam_import_event_manager" model="ir.rule">
        <field name="name">CBAM Import Event: Manager</field>
        <field name="model_id" ref="model_cbam_import_event"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_cbam_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
