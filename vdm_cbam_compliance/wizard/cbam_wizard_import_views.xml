<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbam_wizard_import_form" model="ir.ui.view">
        <field name="name">cbam.wizard.import.form</field>
        <field name="model">cbam.wizard.import</field>
        <field name="arch" type="xml">
            <form string="Import CBAM Data">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="sector"/>
                    <field name="import_date"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cbam_wizard_import" model="ir.actions.act_window">
        <field name="name">Import CBAM Data</field>
        <field name="res_model">cbam.wizard.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
