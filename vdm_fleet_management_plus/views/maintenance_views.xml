<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_tree" model="ir.ui.view">
        <field name="name">fleet.maintenance.list</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="maintenance_type"/>
                <field name="maintenance_date"/>
                <field name="next_date"/>
                <field name="cost"/>
                <field name="vendor_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.form</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" type="object" string="Plan" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_complete" type="object" string="Complete" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Maintenance Description"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="maintenance_type"/>
                            <field name="maintenance_date"/>
                            <field name="next_date"/>
                        </group>
                        <group>
                            <field name="odometer"/>
                            <field name="cost"/>
                            <field name="vendor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parts">
                            <field name="parts_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Maintenance notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_search" model="ir.ui.view">
        <field name="name">fleet.maintenance.search</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Maintenance Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">fleet.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance record
            </p>
            <p>Track vehicle maintenance and schedule preventive maintenance.</p>
        </field>
    </record>
</odoo>
