<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.plus.list</field>
        <field name="model">fleet.vehicle.plus</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="make"/>
                <field name="model"/>
                <field name="driver_id"/>
                <field name="odometer"/>
                <field name="fuel_type"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'maintenance'" decoration-danger="state == 'inactive'"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.plus.form</field>
        <field name="model">fleet.vehicle.plus</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state != 'inactive'"/>
                    <button name="action_maintenance" type="object" string="Maintenance" invisible="state != 'active'"/>
                    <button name="action_deactivate" type="object" string="Deactivate" invisible="state == 'inactive'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Vehicle Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="driver_id"/>
                            <field name="fuel_type"/>
                            <field name="color"/>
                            <field name="odometer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Maintenance">
                            <field name="maintenance_ids"/>
                        </page>
                        <page string="Fuel">
                            <field name="fuel_ids"/>
                        </page>
                        <page string="Insurance">
                            <field name="insurance_ids"/>
                        </page>
                        <page string="Costs">
                            <field name="cost_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Vehicle notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.plus.search</field>
        <field name="model">fleet.vehicle.plus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="driver_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_maintenance" string="In Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Vehicle Type" context="{'group_by': 'vehicle_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_fuel" string="Fuel Type" context="{'group_by': 'fuel_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle.plus</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vehicle
            </p>
            <p>Manage your fleet vehicles with tracking and maintenance.</p>
        </field>
    </record>
</odoo>
