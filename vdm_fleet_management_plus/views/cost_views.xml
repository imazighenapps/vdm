<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_tree" model="ir.ui.view">
        <field name="name">fleet.cost.list</field>
        <field name="model">fleet.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="cost_date"/>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="cost_type"/>
                <field name="amount"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cost_form" model="ir.ui.view">
        <field name="name">fleet.cost.form</field>
        <field name="model">fleet.cost</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Cost Description"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="cost_type"/>
                            <field name="cost_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="partner_id"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Cost notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cost_search" model="ir.ui.view">
        <field name="name">fleet.cost.search</field>
        <field name="model">fleet.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'cost_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cost" model="ir.actions.act_window">
        <field name="name">Costs</field>
        <field name="res_model">fleet.cost</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cost_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cost entry
            </p>
            <p>Track all costs associated with your fleet vehicles.</p>
        </field>
    </record>
</odoo>
