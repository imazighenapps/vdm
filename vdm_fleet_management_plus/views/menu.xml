<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_fleet_plus_root" model="ir.ui.menu">
        <field name="name">Fleet Management Plus</field>
        <field name="sequence">100</field>
        <field name="web_icon">vdm_fleet_management_plus,static/description/icon.png</field>
    </record>

    <record id="menu_fleet_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_fleet_dashboard"/>
        <field name="sequence">10</field>
    </record>

    <record id="menu_fleet_vehicles" model="ir.ui.menu">
        <field name="name">Vehicles</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_vehicle"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_fleet_maintenance" model="ir.ui.menu">
        <field name="name">Maintenance</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_maintenance"/>
        <field name="sequence">30</field>
    </record>

    <record id="menu_fleet_fuel" model="ir.ui.menu">
        <field name="name">Fuel</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_fuel"/>
        <field name="sequence">40</field>
    </record>

    <record id="menu_fleet_insurance" model="ir.ui.menu">
        <field name="name">Insurance</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_insurance"/>
        <field name="sequence">50</field>
    </record>

    <record id="menu_fleet_costs" model="ir.ui.menu">
        <field name="name">Costs</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="action" ref="action_cost"/>
        <field name="sequence">60</field>
    </record>

    <record id="menu_fleet_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_fleet_plus_root"/>
        <field name="sequence">100</field>
        <field name="groups" eval="[(4, ref('group_fleet_manager'))]"/>
    </record>
</odoo>
