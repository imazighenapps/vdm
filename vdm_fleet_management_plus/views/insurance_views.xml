<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_tree" model="ir.ui.view">
        <field name="name">fleet.insurance.list</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="insurance_type"/>
                <field name="provider_id"/>
                <field name="policy_number"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="premium"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_form" model="ir.ui.view">
        <field name="name">fleet.insurance.form</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Expire" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Insurance Description"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="insurance_type"/>
                            <field name="provider_id"/>
                            <field name="policy_number"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="premium"/>
                            <field name="coverage_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Insurance notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_insurance_search" model="ir.ui.view">
        <field name="name">fleet.insurance.search</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="provider_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Insurance Type" context="{'group_by': 'insurance_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insurance" model="ir.actions.act_window">
        <field name="name">Insurance</field>
        <field name="res_model">fleet.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first insurance record
            </p>
            <p>Manage vehicle insurance policies and track expirations.</p>
        </field>
    </record>
</odoo>
