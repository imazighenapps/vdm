<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vehicle" model="ir.actions.report">
        <field name="name">Vehicle Report</field>
        <field name="model">fleet.vehicle.plus</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vdm_fleet_management_plus.report_vehicle</field>
        <field name="report_file">vdm_fleet_management_plus.report_vehicle</field>
        <field name="binding_model_id" ref="model_fleet_vehicle_plus"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_vehicle" model="ir.ui.view">
        <field name="name">vdm_fleet_management_plus.report_vehicle</field>
        <field name="model">ir.qweb</field>
        <field name="arch" type="xml">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Vehicle Report: <t t-out="doc.name"/></h2>
                            <table class="table table-condensed">
                                <tr>
                                    <th>License Plate:</th>
                                    <td><t t-out="doc.license_plate"/></td>
                                </tr>
                                <tr>
                                    <th>Vehicle Type:</th>
                                    <td><t t-out="doc.vehicle_type"/></td>
                                </tr>
                                <tr>
                                    <th>Make/Model:</th>
                                    <td><t t-out="doc.make"/> <t t-out="doc.model"/></td>
                                </tr>
                                <tr>
                                    <th>Year:</th>
                                    <td><t t-out="doc.year"/></td>
                                </tr>
                                <tr>
                                    <th>Driver:</th>
                                    <td><t t-out="doc.driver_id.name"/></td>
                                </tr>
                                <tr>
                                    <th>Odometer:</th>
                                    <td><t t-out="doc.odometer"/> km</td>
                                </tr>
                                <tr>
                                    <th>Total Cost:</th>
                                    <td><t t-fmt="doc.total_cost" t-widget="monetary"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </field>
    </record>
</odoo>
