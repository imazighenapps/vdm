<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Category -->
    <record id="module_category_esg" model="res.groups.privilege">
        <field name="name">ESG Carbon Tracker</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">50</field>
    </record>

    <!-- User Group -->
    <record id="group_esg_user" model="res.groups">
        <field name="name">ESG User</field>
        <field name="privilege_id" ref="module_category_esg"/>
    </record>

    <!-- Manager Group -->
    <record id="group_esg_manager" model="res.groups">
        <field name="name">ESG Manager</field>
        <field name="privilege_id" ref="module_category_esg"/>
        <field name="implied_ids" eval="[(4, ref('group_esg_user'))]"/>
    </record>

    <!-- Admin Group -->
    <record id="group_esg_admin" model="res.groups">
        <field name="name">ESG Admin</field>
        <field name="privilege_id" ref="module_category_esg"/>
        <field name="implied_ids" eval="[(4, ref('group_esg_manager'))]"/>
    </record>
</odoo>
