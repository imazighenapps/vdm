<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_carbon_footprint">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="font-size: 24px; font-weight: bold; margin-bottom: 20px;">Carbon Footprint Report</h2>
                        
                        <div style="margin-bottom: 30px;">
                            <h3 style="font-size: 18px; font-weight: bold;">Company Information</h3>
                            <table class="table table-condensed">
                                <tr><td style="font-weight: bold;">Company:</td><td><t t-field="doc.company_id.name"/></td></tr>
                                <tr><td style="font-weight: bold;">Period:</td><td><t t-field="doc.period_start"/> - <t t-field="doc.period_end"/></td></tr>
                                <tr><td style="font-weight: bold;">Reference:</td><td><t t-field="doc.name"/></td></tr>
                            </table>
                        </div>

                        <div style="margin-bottom: 30px;">
                            <h3 style="font-size: 18px; font-weight: bold;">GHG Protocol Emissions Summary</h3>
                            <table class="table table-condensed">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th style="text-align: left;">Scope</th>
                                        <th style="text-align: right;">Emissions (tCO2e)</th>
                                        <th style="text-align: right;">% of Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Scope 1 - Direct Emissions</td>
                                        <td style="text-align: right;"><t t-field="doc.scope1_total"/></td>
                                        <td style="text-align: right;">
                                            <t t-if="doc.total_emissions > 0">
                                                <t t-esc="round(doc.scope1_total / doc.total_emissions * 100, 1)"/>%
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Scope 2 - Indirect Energy</td>
                                        <td style="text-align: right;"><t t-field="doc.scope2_total"/></td>
                                        <td style="text-align: right;">
                                            <t t-if="doc.total_emissions > 0">
                                                <t t-esc="round(doc.scope2_total / doc.total_emissions * 100, 1)"/>%
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Scope 3 - Value Chain</td>
                                        <td style="text-align: right;"><t t-field="doc.scope3_total"/></td>
                                        <td style="text-align: right;">
                                            <t t-if="doc.total_emissions > 0">
                                                <t t-esc="round(doc.scope3_total / doc.total_emissions * 100, 1)"/>%
                                            </t>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #e8f5e9; font-weight: bold;">
                                        <td>Total Emissions</td>
                                        <td style="text-align: right;"><t t-field="doc.total_emissions"/></td>
                                        <td style="text-align: right;">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-bottom: 30px;">
                            <h3 style="font-size: 18px; font-weight: bold;">Scope 1 Breakdown</h3>
                            <table class="table table-condensed">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th style="text-align: left;">Category</th>
                                        <th style="text-align: right;">Emissions (tCO2e)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>Stationary Combustion</td><td style="text-align: right;"><t t-field="doc.scope1_stationary"/></td></tr>
                                    <tr><td>Mobile Combustion</td><td style="text-align: right;"><t t-field="doc.scope1_mobile"/></td></tr>
                                    <tr><td>Process Emissions</td><td style="text-align: right;"><t t-field="doc.scope1_process"/></td></tr>
                                    <tr><td>Fugitive Emissions</td><td style="text-align: right;"><t t-field="doc.scope1_fugitive"/></td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-bottom: 30px;">
                            <h3 style="font-size: 18px; font-weight: bold;">Carbon Intensity</h3>
                            <table class="table table-condensed">
                                <tr><td style="font-weight: bold;">tCO2e per €M Revenue:</td><td><t t-field="doc.intensity_per_revenue"/></td></tr>
                                <tr><td style="font-weight: bold;">tCO2e per Employee:</td><td><t t-field="doc.intensity_per_employee"/></td></tr>
                                <tr><td style="font-weight: bold;">Reduction vs Base Year:</td><td><t t-field="doc.reduction_vs_base"/>%</td></tr>
                            </table>
                        </div>

                        <div t-if="doc.anomaly_flag" style="margin-bottom: 30px; padding: 15px; background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 5px;">
                            <h3 style="font-size: 18px; font-weight: bold; color: #856404;">Anomaly Alert</h3>
                            <p style="color: #856404;"><t t-field="doc.anomaly_notes"/></p>
                        </div>

                        <div style="margin-top: 40px; font-size: 12px; color: #666;">
                            <p>This report is generated in accordance with the GHG Protocol Corporate Standard and is aligned with EU CSRD/ESRS E1 requirements.</p>
                            <p>Report generated on: <t t-field="doc.posted_date" t-options="{'widget': 'datetime'}"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
