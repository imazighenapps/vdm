<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Wizard Form -->
    <record id="emission_import_wizard_form" model="ir.ui.view">
        <field name="name">emission.import.wizard.form</field>
        <field name="model">emission.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Import Emissions Data</h1>
                    </div>
                    <group>
                        <field name="inventory_id"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="import_format"/>
                        <field name="delimiter"/>
                        <field name="scope_filter"/>
                    </group>
                    <footer>
                        <button name="action_import" string="Import" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="action_emission_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Emissions</field>
        <field name="res_model">emission.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new"/>
    </record>
</odoo>
