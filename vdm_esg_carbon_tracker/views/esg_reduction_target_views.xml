<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reduction Target Form -->
    <record id="esg_reduction_target_form" model="ir.ui.view">
        <field name="name">esg.reduction.target.form</field>
        <field name="model">esg.reduction.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" 
                        class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_achieve" string="Mark as Achieved" type="object" 
                        class="oe_highlight" invisible="status != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                        invisible="status in ('draft', 'achieved', 'cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,achieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Target Name"/></h1>
                    </div>
                    <group>
                        <group string="Target Details">
                            <field name="company_id"/>
                            <field name="target_type"/>
                            <field name="scope"/>
                            <field name="target_year"/>
                            <field name="base_year"/>
                        </group>
                        <group string="Emissions">
                            <field name="base_emissions"/>
                            <field name="target_emissions"/>
                            <field name="reduction_percentage"/>
                            <field name="current_emissions"/>
                            <field name="progress_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="SBTi Alignment">
                            <field name="science_based"/>
                            <field name="alignment_scenario"/>
                            <field name="sbti_validated"/>
                            <field name="sbti_validation_date"/>
                        </group>
                        <group string="Interim Targets">
                            <field name="interim_2030"/>
                            <field name="interim_2035"/>
                            <field name="annual_reduction_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Reduction Target List -->
    <record id="esg_reduction_target_list" model="ir.ui.view">
        <field name="name">esg.reduction.target.list</field>
        <field name="model">esg.reduction.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="target_type"/>
                <field name="scope"/>
                <field name="base_year"/>
                <field name="target_year"/>
                <field name="reduction_percentage"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="science_based" widget="boolean_toggle"/>
                <field name="sbti_validated" widget="boolean_toggle"/>
                <field name="status" widget="badge" decoration-success="status == 'achieved'" 
                    decoration-warning="status == 'active'"/>
            </list>
        </field>
    </record>

    <!-- Reduction Target Search -->
    <record id="esg_reduction_target_search" model="ir.ui.view">
        <field name="name">esg.reduction.target.search</field>
        <field name="model">esg.reduction.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="scope"/>
                <separator/>
                <filter name="active_targets" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="sbti_validated" string="SBTi Validated" domain="[('sbti_validated', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="group_by_target_year" string="Target Year" context="{'group_by': 'target_year'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Reduction Target Action -->
    <record id="action_esg_reduction_target" model="ir.actions.act_window">
        <field name="name">Reduction Targets</field>
        <field name="res_model">esg.reduction.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="esg_reduction_target_search"/>
    </record>
</odoo>
