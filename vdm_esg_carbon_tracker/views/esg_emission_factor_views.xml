<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Emission Factor Form -->
    <record id="esg_emission_factor_form" model="ir.ui.view">
        <field name="name">esg.emission.factor.form</field>
        <field name="model">esg.emission.factor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Emission Factor Name"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code"/>
                            <field name="scope"/>
                            <field name="category"/>
                            <field name="fuel_type"/>
                        </group>
                        <group string="Emission Details">
                            <field name="gas_type"/>
                            <field name="gwp_value"/>
                            <field name="factor_value"/>
                            <field name="unit"/>
                            <field name="compute_method"/>
                        </group>
                    </group>
                    <group>
                        <group string="Source">
                            <field name="source_database"/>
                            <field name="country_id"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                        <group string="Details">
                            <field name="uncertainty" widget="percentage"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Emission Factor List -->
    <record id="esg_emission_factor_list" model="ir.ui.view">
        <field name="name">esg.emission.factor.list</field>
        <field name="model">esg.emission.factor</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="scope"/>
                <field name="category"/>
                <field name="gas_type"/>
                <field name="factor_value"/>
                <field name="unit"/>
                <field name="source_database"/>
            </list>
        </field>
    </record>

    <!-- Emission Factor Search -->
    <record id="esg_emission_factor_search" model="ir.ui.view">
        <field name="name">esg.emission.factor.search</field>
        <field name="model">esg.emission.factor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="scope"/>
                <field name="category"/>
                <field name="source_database"/>
                <separator/>
                <filter name="scope1" string="Scope 1" domain="[('scope', '=', '1')]"/>
                <filter name="scope2" string="Scope 2" domain="[('scope', '=', '2')]"/>
                <filter name="scope3" string="Scope 3" domain="[('scope', '=', '3')]"/>
            </search>
        </field>
    </record>

    <!-- Emission Factor Action -->
    <record id="action_esg_emission_factor" model="ir.actions.act_window">
        <field name="name">Emission Factors</field>
        <field name="res_model">esg.emission.factor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="esg_emission_factor_search"/>
    </record>
</odoo>
