<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Emission Line Form -->
    <record id="esg_emission_line_form" model="ir.ui.view">
        <field name="name">esg.emission.line.form</field>
        <field name="model">esg.emission.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Validate" type="object" 
                        class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" 
                        class="oe_highlight" invisible="state != 'validated'"/>
                    <button name="action_reset" string="Reset to Draft" type="object" 
                        invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Emission Line Description"/></h1>
                    </div>
                    <group>
                        <group string="Emission Details">
                            <field name="inventory_id" invisible="1"/>
                            <field name="emission_factor_id"/>
                            <field name="date"/>
                            <field name="activity_date"/>
                        </group>
                        <group string="Activity Data">
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Calculated Emissions">
                            <field name="emissions_kg"/>
                            <field name="emissions_tco2e"/>
                            <field name="gas_type"/>
                        </group>
                        <group string="Source">
                            <field name="source_document"/>
                            <field name="source_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Emission Line List -->
    <record id="esg_emission_line_list" model="ir.ui.view">
        <field name="name">esg.emission.line.list</field>
        <field name="model">esg.emission.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="emission_factor_id"/>
                <field name="scope"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="emissions_tco2e"/>
                <field name="gas_type"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" 
                    decoration-warning="state == 'validated'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Emission Line Search -->
    <record id="esg_emission_line_search" model="ir.ui.view">
        <field name="name">esg.emission.line.search</field>
        <field name="model">esg.emission.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="scope1" string="Scope 1" domain="[('scope', '=', '1')]"/>
                <filter name="scope2" string="Scope 2" domain="[('scope', '=', '2')]"/>
                <filter name="scope3" string="Scope 3" domain="[('scope', '=', '3')]"/>
                <separator/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Emission Line Action -->
    <record id="action_esg_emission_line" model="ir.actions.act_window">
        <field name="name">Emission Lines</field>
        <field name="res_model">esg.emission.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="esg_emission_line_search"/>
    </record>
</odoo>
