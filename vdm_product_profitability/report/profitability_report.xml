<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_profitability" model="ir.actions.report">
        <field name="name">Profitability Report</field>
        <field name="model">product.profitability</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vdm_product_profitability.report_profitability</field>
        <field name="report_file">vdm_product_profitability.report_profitability</field>
        <field name="binding_model_id" ref="model_product_profitability"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_profitability" model="ir.ui.view">
        <field name="name">vdm_product_profitability.report_profitability</field>
        <field name="model">ir.qweb</field>
        <field name="arch" type="xml">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Profitability Report: <t t-out="doc.name"/></h2>
                            <table class="table table-condensed">
                                <tr>
                                    <th>Product:</th>
                                    <td><t t-out="doc.product_id.name"/></td>
                                </tr>
                                <tr>
                                    <th>Category:</th>
                                    <td><t t-out="doc.categ_id.name"/></td>
                                </tr>
                                <tr>
                                    <th>Period:</th>
                                    <td><t t-out="doc.date_from"/> to <t t-out="doc.date_to"/></td>
                                </tr>
                            </table>
                            <h3>Summary</h3>
                            <table class="table table-condensed">
                                <tr>
                                    <th>Total Sales:</th>
                                    <td><t t-fmt="doc.total_sales" t-widget="monetary"/></td>
                                </tr>
                                <tr>
                                    <th>Total Cost:</th>
                                    <td><t t-fmt="doc.total_cost" t-widget="monetary"/></td>
                                </tr>
                                <tr>
                                    <th>Gross Profit:</th>
                                    <td><t t-fmt="doc.gross_profit" t-widget="monetary"/></td>
                                </tr>
                                <tr>
                                    <th>Profit Margin:</th>
                                    <td><t t-out="doc.profit_margin"/>%</td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </field>
    </record>
</odoo>
