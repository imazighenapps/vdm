<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_profitability" model="ir.module.category">
        <field name="name">Product Profitability</field>
        <field name="description">Product profitability analysis and reporting</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_profitability_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_product_profitability"/>
        <field name="comment">Basic access to profitability analysis</field>
    </record>

    <record id="group_profitability_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_product_profitability"/>
        <field name="implied_ids" eval="[(4, ref('group_profitability_user'))]"/>
        <field name="comment">Full access to profitability analysis and reporting</field>
    </record>

    <record id="group_profitability_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_product_profitability"/>
        <field name="implied_ids" eval="[(4, ref('group_profitability_manager'))]"/>
        <field name="comment">Full system access including configuration</field>
    </record>

    <!-- Record Rules -->
    <record id="rule_profitability_user" model="ir.rule">
        <field name="name">Profitability: User Read Only</field>
        <field name="model_id" ref="model_product_profitability"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_profitability_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_profitability_manager" model="ir.rule">
        <field name="name">Profitability: Manager Full Access</field>
        <field name="model_id" ref="model_product_profitability"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_profitability_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_profitability_line_user" model="ir.rule">
        <field name="name">Profitability Line: User Read Only</field>
        <field name="model_id" ref="model_product_profitability_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_profitability_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_profitability_line_manager" model="ir.rule">
        <field name="name">Profitability Line: Manager Full Access</field>
        <field name="model_id" ref="model_product_profitability_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_profitability_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
