<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profitability_tree" model="ir.ui.view">
        <field name="name">product.profitability.list</field>
        <field name="model">product.profitability</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_sales"/>
                <field name="total_cost"/>
                <field name="gross_profit"/>
                <field name="profit_margin" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_profitability_form" model="ir.ui.view">
        <field name="name">product.profitability.form</field>
        <field name="model">product.profitability</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Compute" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profitability Analysis"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="categ_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_sales"/>
                            <field name="total_quantity"/>
                            <field name="avg_selling_price"/>
                        </group>
                        <group>
                            <field name="total_cost"/>
                            <field name="cost_per_unit"/>
                        </group>
                        <group>
                            <field name="gross_profit"/>
                            <field name="profit_margin"/>
                            <field name="profit_per_unit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <field name="line_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Analysis notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_profitability_search" model="ir.ui.view">
        <field name="name">product.profitability.search</field>
        <field name="model">product.profitability</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_computed" string="Computed" domain="[('state', '=', 'computed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_profitability" model="ir.actions.act_window">
        <field name="name">Profitability Analysis</field>
        <field name="res_model">product.profitability</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_profitability_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first profitability analysis
            </p>
            <p>Analyze product profitability and margins.</p>
        </field>
    </record>
</odoo>
