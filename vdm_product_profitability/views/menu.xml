<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_profitability_root" model="ir.ui.menu">
        <field name="name">Product Profitability</field>
        <field name="sequence">100</field>
        <field name="web_icon">vdm_product_profitability,static/description/icon.png</field>
    </record>

    <record id="menu_profitability_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="menu_profitability_root"/>
        <field name="action" ref="action_profitability_dashboard"/>
        <field name="sequence">10</field>
    </record>

    <record id="menu_profitability_analysis" model="ir.ui.menu">
        <field name="name">Profitability Analysis</field>
        <field name="parent_id" ref="menu_profitability_root"/>
        <field name="action" ref="action_profitability"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_profitability_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_profitability_root"/>
        <field name="sequence">100</field>
        <field name="groups" eval="[(4, ref('group_profitability_manager'))]"/>
    </record>
</odoo>
