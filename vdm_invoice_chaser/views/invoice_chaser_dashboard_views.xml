<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Action -->
    <record id="action_invoice_chaser_dashboard" model="ir.actions.client">
        <field name="name">Invoice Chaser Dashboard</field>
        <field name="tag">chaser_dashboard</field>
    </record>

    <!-- Overdue Invoices Action -->
    <record id="action_overdue_invoices" model="ir.actions.act_window">
        <field name="name">Overdue Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('state', '=', 'posted'), ('payment_state', '!=', 'paid'), ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]</field>
    </record>
</odoo>
