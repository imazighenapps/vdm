<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move List Extension -->
    <record id="invoice_chaser_list" model="ir.ui.view">
        <field name="name">account.move.list.chaser</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="days_overdue" readonly="1"/>
                <field name="reminder_level" readonly="1"/>
                <field name="last_reminder_date" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Form Extension -->
    <record id="invoice_chaser_form" model="ir.ui.view">
        <field name="name">account.move.form.chaser</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reminder_history" type="object" class="oe_stat_button" 
                    icon="fa-clock-o" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="reminder_count"/></span>
                        <span class="o_stat_text">Reminders</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="days_overdue" readonly="1" invisible="invoice_date_due == False"/>
                <field name="reminder_level" readonly="1" widget="badge" 
                    decoration-success="reminder_level == 'none'"
                    decoration-warning="reminder_level == 'gentle'"
                    decoration-danger="reminder_level in ('firm', 'legal')"
                    invisible="invoice_date_due == False"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_send_reminder" string="Send Reminder" type="object" 
                    class="btn-warning"
                    invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or payment_state == 'paid' or days_overdue &lt; 7"/>
            </xpath>
        </field>
    </record>

    <!-- Reminder Log List -->
    <record id="invoice_reminder_log_list" model="ir.ui.view">
        <field name="name">invoice.reminder.log.list</field>
        <field name="model">invoice.reminder.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="send_date"/>
                <field name="invoice_number"/>
                <field name="partner_id"/>
                <field name="level" widget="badge" 
                    decoration-warning="level == 'gentle'"
                    decoration-danger="level == 'firm'"
                    decoration-danger="level == 'legal'"/>
                <field name="days_overdue"/>
                <field name="amount_overdue"/>
                <field name="send_uid"/>
            </list>
        </field>
    </record>

    <!-- Reminder Log Search -->
    <record id="invoice_reminder_log_search" model="ir.ui.view">
        <field name="name">invoice.reminder.log.search</field>
        <field name="model">invoice.reminder.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_number"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="gentle" string="Gentle" domain="[('level', '=', 'gentle')]"/>
                <filter name="firm" string="Firm" domain="[('level', '=', 'firm')]"/>
                <filter name="legal" string="Legal" domain="[('level', '=', 'legal')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'send_date'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
