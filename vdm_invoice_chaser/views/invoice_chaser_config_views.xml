<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Config Form -->
    <record id="invoice_chaser_config_form" model="ir.ui.view">
        <field name="name">invoice.chaser.config.form</field>
        <field name="model">invoice.chaser.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Invoice Chaser Settings</h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="company_id"/>
                            <field name="enabled"/>
                            <field name="auto_send"/>
                        </group>
                        <group string="Reminders">
                            <field name="reminder_j7"/>
                            <field name="reminder_j15"/>
                            <field name="reminder_j30"/>
                            <field name="reminder_j60"/>
                        </group>
                    </group>
                    <group>
                        <group string="Filters">
                            <field name="min_amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Escalation">
                            <field name="escalate_manager"/>
                            <field name="escalate_threshold"/>
                            <field name="manager_user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_chaser_config" model="ir.actions.act_window">
        <field name="name">Chaser Settings</field>
        <field name="res_model">invoice.chaser.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
