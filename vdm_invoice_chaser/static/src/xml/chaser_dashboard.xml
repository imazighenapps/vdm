<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="vdm_invoice_chaser.ChaserDashboard">
        <div class="o_chaser_dashboard">
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x"/>
                    <p class="mt-3">Loading Dashboard...</p>
                </div>
            </t>
            <t t-else="">
                <!-- Summary Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <h6 class="card-title">Total Overdue</h6>
                                <h2 class="card-text" t-out="state.summary.total_overdue?.toFixed(2) || '0.00'"/>
                                <small><t t-out="state.summary.count_overdue || 0"/> invoices</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <h6 class="card-title">7-15 Days</h6>
                                <h2 class="card-text" t-out="state.summary.count_j7 || 0"/>
                                <small t-out="state.summary.amount_j7?.toFixed(2) || '0.00'"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <h6 class="card-title">15-30 Days</h6>
                                <h2 class="card-text" t-out="state.summary.count_j15 || 0"/>
                                <small t-out="state.summary.amount_j15?.toFixed(2) || '0.00'"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white" style="background-color: #8b0000;">
                            <div class="card-body">
                                <h6 class="card-title">60+ Days</h6>
                                <h2 class="card-text" t-out="state.summary.count_j60 || 0"/>
                                <small t-out="state.summary.amount_j60?.toFixed(2) || '0.00'"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Overdue -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Top Overdue Customers</h5>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Customer</th>
                                            <th class="text-center">Invoices</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-center">Max Days</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.topOverdue" t-as="row">
                                            <tr>
                                                <td t-out="row.partner"/>
                                                <td class="text-center" t-out="row.count"/>
                                                <td class="text-end" t-out="row.amount?.toFixed(2) || '0'"/>
                                                <td class="text-center">
                                                    <span class="badge" 
                                                          t-att-class="row.max_days >= 60 ? 'bg-danger' : row.max_days >= 30 ? 'bg-warning' : 'bg-info'"
                                                          t-out="row.max_days + 'd'"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Recent Reminders</h5>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Invoice</th>
                                            <th>Level</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.recentLogs" t-as="log">
                                            <tr>
                                                <td t-out="log.invoice"/>
                                                <td>
                                                    <span class="badge" 
                                                          t-att-class="log.level == 'legal' ? 'bg-danger' : log.level == 'firm' ? 'bg-warning' : 'bg-info'"
                                                          t-out="log.level"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row">
                    <div class="col-md-4">
                        <button class="btn btn-primary w-100" t-on-click="navigateToOverdue">
                            <i class="fa fa-exclamation-triangle"/> View Overdue Invoices
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-warning w-100" t-on-click="sendAllReminders">
                            <i class="fa fa-paper-plane"/> Send Bulk Reminders
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-info w-100" t-on-click="navigateToLogs">
                            <i class="fa fa-history"/> View Reminder History
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
