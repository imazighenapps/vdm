<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_invoice_chaser" model="res.groups.privilege">
        <field name="name">Invoice Chaser Pro</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_invoice_chaser_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="module_category_invoice_chaser"/>
    </record>

    <record id="group_invoice_chaser_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="module_category_invoice_chaser"/>
        <field name="implied_ids" eval="[(4, ref('group_invoice_chaser_user'))]"/>
    </record>
</odoo>
