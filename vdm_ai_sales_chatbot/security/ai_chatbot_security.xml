<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="module_category_ai_chatbot" model="res.groups.privilege">
        <field name="name">AI Chatbot</field>
        <field name="category_id" ref="base.module_category_crm"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_ai_chatbot_user" model="res.groups">
        <field name="name">Chatbot User</field>
        <field name="privilege_id" ref="module_category_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('crm.group_use_lead'))]"/>
    </record>

    <record id="group_ai_chatbot_manager" model="res.groups">
        <field name="name">Chatbot Manager</field>
        <field name="privilege_id" ref="module_category_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_chatbot_user'))]"/>
    </record>

    <record id="group_ai_chatbot_admin" model="res.groups">
        <field name="name">Chatbot Admin</field>
        <field name="privilege_id" ref="module_category_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_chatbot_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_ai_chatbot_config_user" model="ir.rule">
        <field name="name">AI Chatbot Config: User</field>
        <field name="model_id" ref="model_ai_chatbot_config"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ai_chatbot_config_manager" model="ir.rule">
        <field name="name">AI Chatbot Config: Manager</field>
        <field name="model_id" ref="model_ai_chatbot_config"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ai_chatbot_conversation_user" model="ir.rule">
        <field name="name">AI Chatbot Conversation: User</field>
        <field name="model_id" ref="model_ai_chatbot_conversation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ai_chatbot_conversation_manager" model="ir.rule">
        <field name="name">AI Chatbot Conversation: Manager</field>
        <field name="model_id" ref="model_ai_chatbot_conversation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ai_chatbot_conversation_company" model="ir.rule">
        <field name="name">AI Chatbot Conversation: Multi-Company</field>
        <field name="model_id" ref="model_ai_chatbot_conversation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_user'))]"/>
    </record>

    <record id="rule_ai_chatbot_config_company" model="ir.rule">
        <field name="name">AI Chatbot Config: Multi-Company</field>
        <field name="model_id" ref="model_ai_chatbot_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chatbot_user'))]"/>
    </record>
</odoo>
