<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="vdm_ai_sales_chatbot.AiChatbotComponent">
        <div class="o_ai_chatbot_container">
            <button class="o_ai_chatbot_toggle btn btn-primary rounded-circle"
                    t-on-click="toggleChat">
                <i class="fa fa-comments"/>
            </button>

            <t t-if="state.isOpen">
                <div class="o_ai_chatbot_window card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span>AI Assistant</span>
                        <button class="btn btn-sm btn-outline-light" t-on-click="toggleChat">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="card-body o_ai_chatbot_messages">
                        <t t-foreach="state.messages" t-as="msg">
                            <div t-attf-class="o_ai_chatbot_message mb-2 {{ msg.sender_type === 'bot' ? 'text-start' : 'text-end' }}">
                                <div t-attf-class="d-inline-block p-2 rounded {{ msg.sender_type === 'bot' ? 'bg-light' : 'bg-primary text-white' }}"
                                     style="max-width: 80%;">
                                    <t t-out="msg.body"/>
                                </div>
                            </div>
                        </t>
                        <t t-if="state.isLoading">
                            <div class="text-center text-muted">
                                <i class="fa fa-spinner fa-spin"/> Typing...
                            </div>
                        </t>
                    </div>
                    <div class="card-footer">
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Type your message..."
                                   t-model="state.inputMessage"
                                   t-on-keydown="onKeydown"/>
                            <button class="btn btn-primary" t-on-click="sendMessage">
                                <i class="fa fa-paper-plane"/>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
