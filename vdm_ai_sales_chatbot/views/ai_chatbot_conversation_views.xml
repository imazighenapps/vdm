<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_chatbot_conversation_form" model="ir.ui.view">
        <field name="name">ai.chatbot.conversation.form</field>
        <field name="model">ai.chatbot.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close"
                            invisible="status == 'closed'" class="oe_highlight"/>
                    <button name="action_escalate" type="object" string="Escalate to Human"
                            invisible="status != 'active'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="status != 'waiting'"/>
                    <button name="create_lead" type="object" string="Create CRM Lead"
                            invisible="lead_id" class="oe_highlight"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="contact_name"/>
                            <field name="contact_phone"/>
                            <field name="contact_email"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Details">
                            <field name="channel" widget="badge"/>
                            <field name="config_id"/>
                            <field name="message_count"/>
                            <field name="last_message_date"/>
                            <field name="assigned_user_id"/>
                            <field name="lead_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="status == 'closed'"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_chatbot_conversation_list" model="ir.ui.view">
        <field name="name">ai.chatbot.conversation.list</field>
        <field name="model">ai.chatbot.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations" decoration-danger="status == 'waiting'"
                  decoration-success="status == 'active'" decoration-muted="status == 'closed'">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="contact_phone"/>
                <field name="channel" widget="badge"/>
                <field name="message_count"/>
                <field name="last_message" optional="show"/>
                <field name="last_message_date"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_ai_chatbot_conversation_search" model="ir.ui.view">
        <field name="name">ai.chatbot.conversation.search</field>
        <field name="model">ai.chatbot.conversation</field>
        <field name="arch" type="xml">
            <search string="Conversations">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="contact_phone"/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_waiting" string="Waiting" domain="[('status', '=', 'waiting')]"/>
                <filter name="filter_closed" string="Closed" domain="[('status', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_whatsapp" string="WhatsApp" domain="[('channel', '=', 'whatsapp')]"/>
                <filter name="filter_website" string="Website" domain="[('channel', '=', 'website')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'last_message_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_chatbot_conversations" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">ai.chatbot.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations yet.
            </p>
            <p>
                Conversations will appear here when customers interact with your chatbot.
            </p>
        </field>
    </record>
</odoo>
