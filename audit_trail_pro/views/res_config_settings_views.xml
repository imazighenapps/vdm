<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.audit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.view_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Audit Trail" data-key="audit_trail_pro" groups="audit_trail_pro.group_audit_manager">
                    <h2>Audit Trail Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="audit_enable_logging"/>
                                <div class="text-muted">
                                    Enable or disable audit logging globally
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="audit_log_retention"/>
                                <div class="text-muted">
                                    Automatically cleanup old audit logs
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="audit_enable_alerts"/>
                                <div class="text-muted">
                                    Enable alert system for suspicious activities
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="audit_enable_risk_scoring"/>
                                <div class="text-muted">
                                    Calculate risk scores for user actions
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt16">
                        <button name="action_open_audit_config" type="object" class="btn btn-primary">
                            Open Audit Configuration
                        </button>
                        <button name="action_view_audit_logs" type="object" class="btn btn-secondary">
                            View Audit Logs
                        </button>
                        <button name="action_view_dashboard" type="object" class="btn btn-secondary">
                            View Dashboard
                        </button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
