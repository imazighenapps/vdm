<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <record id="menu_audit_root" model="ir.ui.menu">
        <field name="name">Audit</field>
        <field name="sequence">100</field>
        <field name="web_icon">audit_trail_pro,static/description/icon.png</field>
    </record>

    <!-- Dashboard -->
    <record id="menu_audit_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="menu_audit_root"/>
        <field name="action" ref="action_audit_dashboard"/>
        <field name="sequence">10</field>
    </record>

    <!-- Logs -->
    <record id="menu_audit_logs" model="ir.ui.menu">
        <field name="name">Logs</field>
        <field name="parent_id" ref="menu_audit_root"/>
        <field name="action" ref="action_audit_log"/>
        <field name="sequence">20</field>
    </record>

    <!-- Alerts -->
    <record id="menu_audit_alerts" model="ir.ui.menu">
        <field name="name">Alerts</field>
        <field name="parent_id" ref="menu_audit_root"/>
        <field name="action" ref="action_audit_alert"/>
        <field name="sequence">30</field>
    </record>

    <!-- High Risk Users -->
    <record id="menu_audit_high_risk" model="ir.ui.menu">
        <field name="name">High Risk Users</field>
        <field name="parent_id" ref="menu_audit_root"/>
        <field name="action" ref="action_audit_high_risk_users"/>
        <field name="sequence">40</field>
    </record>

    <!-- Configuration -->
    <record id="menu_audit_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_audit_root"/>
        <field name="action" ref="action_audit_config"/>
        <field name="sequence">50</field>
        <field name="groups" eval="[(4, ref('group_audit_manager'))]"/>
    </record>

    <!-- High Risk Users Action -->
    <record id="action_audit_high_risk_users" model="ir.actions.act_window">
        <field name="name">High Risk Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('audit_risk_score', '>', 50)]</field>
        <field name="context">{'search_default过滤器': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No high risk users
            </p>
            <p>Users with risk score above 50 will appear here.</p>
        </field>
    </record>
</odoo>
