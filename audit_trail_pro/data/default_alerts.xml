<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="alert_bulk_deletion" model="audit.trail.alert">
            <field name="name">Bulk Deletion Detected</field>
            <field name="alert_type">bulk_delete</field>
            <field name="threshold">10</field>
            <field name="time_window">60</field>
            <field name="severity">high</field>
            <field name="state">active</field>
        </record>

        <record id="alert_bulk_export" model="audit.trail.alert">
            <field name="name">Bulk Export Detected</field>
            <field name="alert_type">bulk_export</field>
            <field name="threshold">5</field>
            <field name="time_window">30</field>
            <field name="severity">medium</field>
            <field name="state">active</field>
        </record>

        <record id="alert_new_ip" model="audit.trail.alert">
            <field name="name">New IP Address Login</field>
            <field name="alert_type">new_ip</field>
            <field name="threshold">1</field>
            <field name="time_window">1440</field>
            <field name="severity">medium</field>
            <field name="state">active</field>
        </record>

        <record id="alert_off_hours" model="audit.trail.alert">
            <field name="name">Off-Hours Activity</field>
            <field name="alert_type">off_hours</field>
            <field name="threshold">1</field>
            <field name="time_window">60</field>
            <field name="severity">low</field>
            <field name="state">active</field>
        </record>

        <record id="alert_rights_change" model="audit.trail.alert">
            <field name="name">Rights Change Detected</field>
            <field name="alert_type">rights_change</field>
            <field name="threshold">1</field>
            <field name="time_window">60</field>
            <field name="severity">critical</field>
            <field name="state">active</field>
        </record>

        <record id="alert_invoice_delete" model="audit.trail.alert">
            <field name="name">Invoice Deletion</field>
            <field name="alert_type">invoice_delete</field>
            <field name="threshold">1</field>
            <field name="time_window">60</field>
            <field name="severity">critical</field>
            <field name="state">active</field>
        </record>

        <record id="alert_payment_cancel" model="audit.trail.alert">
            <field name="name">Payment Cancellation</field>
            <field name="alert_type">payment_cancel</field>
            <field name="threshold">1</field>
            <field name="time_window">60</field>
            <field name="severity">high</field>
            <field name="state">active</field>
        </record>

        <record id="alert_failed_login" model="audit.trail.alert">
            <field name="name">Multiple Failed Logins</field>
            <field name="alert_type">failed_login</field>
            <field name="threshold">5</field>
            <field name="time_window">30</field>
            <field name="severity">high</field>
            <field name="state">active</field>
        </record>
    </data>
</odoo>
