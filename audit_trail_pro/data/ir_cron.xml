<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_cleanup_audit_logs" model="ir.cron">
            <field name="name">Audit Trail: Cleanup Old Logs</field>
            <field name="model_id" ref="model_audit_trail_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_check_failed_logins" model="ir.cron">
            <field name="name">Audit Trail: Check Failed Logins</field>
            <field name="model_id" ref="model_audit_trail_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_failed_logins()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
