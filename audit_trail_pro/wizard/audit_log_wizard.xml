<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_log_export_wizard_form" model="ir.ui.view">
        <field name="name">audit.log.export.wizard.form</field>
        <field name="model">audit.log.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Export Audit Logs"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="export_format"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="action_type"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_export" type="object" string="Export" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_audit_log_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Audit Logs</field>
        <field name="res_model">audit.log.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
